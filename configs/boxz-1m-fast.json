{
  "run_name": "base-fast",
  "model": {
    "vocab_size": 2048,
    "n_layer": 6,
    "n_head": 6,
    "d_model": 192,
    "d_ff": 768,
    "context_length": 128,
    "dropout": 0.0,
    "norm": "layernorm",
    "activation": "gelu",
    "pos_embeddings": "learned",
    "tied_embeddings": true
  },
  "data": {
    "dataset": [
      "tinyshakespeare",
      "boxz_web_code_dedup"
    ],
    "vocab_size": 2048,
    "val_fraction": 0.02,
    "cache_dir": "data/processed",
    "sft_holdout": 16,
    "exclude_sft_holdout": true
  },
  "batch_size": 24,
  "grad_accum_steps": 1,
  "max_steps": 700,
  "lr": 0.0015,
  "min_lr": 0.00012,
  "warmup_steps": 100,
  "schedule": "cosine",
  "weight_decay": 0.01,
  "grad_clip": 1.0,
  "eval_interval": 100,
  "eval_batches": 16,
  "log_interval": 20,
  "checkpoint_interval": 100,
  "checkpoint_dir": "checkpoints",
  "seed": 1337,
  "max_minutes": 28
}