{
  "run_name": "tiny",
  "model": {
    "vocab_size": 4096,
    "n_layer": 6,
    "n_head": 6,
    "d_model": 192,
    "d_ff": 768,
    "context_length": 192,
    "dropout": 0.0,
    "norm": "layernorm",
    "activation": "gelu",
    "pos_embeddings": "learned",
    "tied_embeddings": true
  },
  "data": {
    "dataset": "tinyshakespeare",
    "vocab_size": 4096,
    "val_fraction": 0.05,
    "cache_dir": "data/processed"
  },
  "batch_size": 16,
  "grad_accum_steps": 1,
  "max_steps": 3000,
  "lr": 0.0015,
  "min_lr": 0.00015,
  "warmup_steps": 150,
  "schedule": "cosine",
  "weight_decay": 0.01,
  "grad_clip": 1.0,
  "eval_interval": 250,
  "eval_batches": 20,
  "log_interval": 25,
  "checkpoint_interval": 500,
  "checkpoint_dir": "checkpoints",
  "seed": 1337
}
