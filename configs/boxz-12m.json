  "lr": 0.001,
  "min_lr": 0.0001,
  "warmup_steps": 120,
  "schedule": "cosine",
  "weight_decay": 0.01,
  "grad_clip": 1.0,
  "eval_interval": 200,
  "eval_batches": 4,
  "log_interval": 25,
  "checkpoint_interval": 600,
  "checkpoint_dir": "checkpoints/boxz-12m",
